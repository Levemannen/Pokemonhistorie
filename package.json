{
  "name": "lost-starlight",
  "version": "3.0.1",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "art": "tsx scripts/art.ts && tsx scripts/sync-painted.ts",
    "build": "tsc -b && vite build && node scripts/build-pwa.mjs",
    "test:full": "pnpm test && pnpm build && node scripts/deployment-test.mjs",
    "test": "pnpm test:compat && pnpm test:v3",
    "export:story": "tsx scripts/export-edition.ts",
    "test:v3": "tsx scripts/v3-test.ts",
    "test:compat": "tsx scripts/edition-test.ts && tsx scripts/edition-presentation-test.tsx && tsx scripts/editorial-test.ts",
    "test:browser:v3": "tsx scripts/browser-v3.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0",
    "typescript": "~5.7.3",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "tsx": "^4.19.0"
  }
}
